/*
 * Plik arkusza styli styles.qss.
 * Ciemny motyw Cold Turkey Blocker. Zero wywolan setStyleSheet w kodzie C++.
 */

QWidget {
    background-color: #212121;
    color: #f1f1f1;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #212121;
}

/* ================= PASEK BOCZNY ================= */

QWidget#sidebarContainer {
    background-color: #171717;
    border-right: 1px solid #2b2b2b;
}

QLabel#sidebarLogo {
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    line-height: 22px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #b5b5b5;
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#navButton:hover {
    background-color: #282828;
    color: #ffffff;
}

QPushButton#fixExtensionsBtn {
    background-color: #d9534f;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: bold;
}

QPushButton#stopButton {
    background-color: #7a1f1d;
    color: #ffffff;
    border: 1px solid #a82e2a;
    border-radius: 4px;
    padding: 8px 12px;
    font-weight: bold;
}

/* ================= KAFELKI I PRZYCISKI BLOKOW ================= */

QWidget#blockRowCard {
    background-color: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 6px;
}

QPushButton#blockTitleButton {
    background: transparent;
    border: none;
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    text-align: left;
    padding: 0px;
}

QPushButton#blockTitleButton:hover {
    color: #6cb33f;
}

QLabel#blockSubtitle {
    font-size: 12px;
    color: #9e9e9e;
}

QWidget#indicatorActive {
    background-color: #6cb33f;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QWidget#indicatorInactive {
    background-color: #424242;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QPushButton#toggleOnBtn {
    background-color: #6cb33f;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-weight: bold;
    padding: 4px 14px;
}

QPushButton#toggleOffBtn {
    background-color: #484848;
    color: #b0b0b0;
    border: none;
    border-radius: 12px;
    font-weight: bold;
    padding: 4px 14px;
}

QPushButton#lockLockedBtn {
    background-color: #333333;
    color: #cccccc;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QPushButton#lockUnlockedBtn {
    background-color: #262626;
    color: #888888;
    border: 1px solid #383838;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QPushButton#breakActionBtn {
    background-color: #30343f;
    color: #80c0ff;
    border: 1px solid #40485a;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#breakActionBtn:hover {
    background-color: #3a4050;
}

QPushButton#breakCritBtn {
    background-color: #442020;
    color: #ff8080;
    border: 1px solid #663030;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#breakCritBtn:hover {
    background-color: #552828;
}

/* ================= DIALOGI I FORMULARZE ================= */

QLabel#dialogHeader {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 8px;
}

QLabel#lockWarningBanner {
    background-color: #3d2a10;
    color: #ffd280;
    border: 1px solid #66461a;
    border-radius: 4px;
    padding: 6px;
    font-size: 12px;
}

QPushButton#primaryGreenBtn {
    background-color: #6cb33f;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton#primaryGreenBtn:hover {
    background-color: #5ca034;
}

QTabWidget::pane {
    border: 1px solid #383838;
    background-color: #262626;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #1e1e1e;
    color: #9e9e9e;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #262626;
    color: #ffffff;
    font-weight: bold;
    border-bottom: 2px solid #6cb33f;
}

QLineEdit, QSpinBox, QListWidget, QTableWidget {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #383838;
    border-radius: 4px;
    padding: 6px;
}

/* ================= UNLOCK CHALLENGE DIALOG ================= */

QLabel#targetWordPrompt {
    font-size: 28px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 2px;
    padding: 4px 0;
}

QFrame#typingCardFrame {
    background-color: #16181f;
    border: 2px solid #282c35;
    border-radius: 8px;
}

QLabel#cheatWarningLabel {
    color: #34c759;
    font-size: 11px;
    font-weight: bold;
}

QLabel#cheatWarningActive {
    color: #ff3b30;
    font-size: 12px;
    font-weight: bold;
}

QLabel#feedbackSuccess {
    color: #34c759;
    font-size: 12px;
    font-weight: bold;
}

QLabel#feedbackError {
    color: #ff3b30;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#giveUpBtn {
    background: #1c202a;
    color: #8a90a0;
    border: 1px solid #282c35;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: bold;
}