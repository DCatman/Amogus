{
  "manifest_version": 3,
  "name": "Amogus Blocker Companion",
  "version": "2.1",
  "description": "Blokada stron i filtr YouTube dla aplikacji Amogus Blocker",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:13370/*",
    "http://localhost:13370/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "css": ["shield.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "HAL9000.png",
    "48": "HAL9000.png",
    "128": "HAL9000.png"
  }
}

