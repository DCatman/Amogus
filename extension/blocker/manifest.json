{
  "manifest_version": 3,
  "name": "Amogus Site Blocker",
  "version": "0.30.0",
  "description": "Biała lista stron, filtr YouTube po @handle, harmonogramy, limity, wyjątki i historia.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Amogus Blocker",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-filter.js"
      ],
      "css": [
        "youtube-filter.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
